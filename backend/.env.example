# Node Environment
NODE_ENV=development

# Server Configuration
API_ADDR=localhost:8080
API_PORT=8080
POSTGRES_PORT=5432
# Public origin of this backend (optional). When set, every backend-hosted URL
# (email unsubscribe links, the calendar feed, unset OAuth callback URLs) uses
# it, and it must be a bare origin (scheme://host[:port]), not a loopback one in
# production or stage. When unset, the production and stage frontends map to
# their API hosts and, outside production and stage, a localhost FRONTEND_URL
# uses http://localhost on API_ADDR's port. The server refuses to boot on any
# other combination.
# BACKEND_PUBLIC_URL=http://localhost:8080

# Database Configuration
POSTGRES_DB=psychicdb
POSTGRES_USER=psychicadmin
POSTGRES_PASSWORD=secretpassword
DATABASE_URL=postgres://psychicadmin:secretpassword@localhost:5432/psychicdb?sslmode=disable&timezone=UTC

# Connection pool bounds (optional; these are the defaults).
# Unset, database/sql leaves the pool UNLIMITED.
# DB_MAX_OPEN_CONNS=20
# DB_MAX_IDLE_CONNS=10
# DB_CONN_MAX_LIFETIME_MINUTES=30

# OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:8080/auth/callback/google
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:8080/auth/callback/github

# Security Keys
OAUTH_SECRET_KEY=development-oauth-secret-key-32-chars-long
JWT_SECRET_KEY=development-jwt-secret-key-32-chars-long
SESSION_SECRET=development-oauth-secret-key-32-chars-long

# JWT Configuration
# JWT_EXPIRY_HOURS: session lifetime in hours. Leave unset for the code default (1440 = 60 days);
# setting it pins the lifetime across deploys and rollbacks.
# JWT_EXPIRY_HOURS=1440

# Session Configuration
SESSION_PATH=/
SESSION_DOMAIN=localhost  # ← Could be empty for development
SESSION_MAX_AGE=86400
SESSION_HTTP_ONLY=true
SESSION_SECURE=false
SESSION_SAME_SITE=lax

# CORS Configuration (NEW - if you make it configurable)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://psychichomily.com,https://www.psychichomily.com

# Logging Configuration (NEW)
LOG_LEVEL=debug  # ← MISSING: More verbose for development

# PgAdmin for development
PGADMIN_DEFAULT_EMAIL=admin@psychichomily.local
PGADMIN_DEFAULT_PASSWORD=admin123
