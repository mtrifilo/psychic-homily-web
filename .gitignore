# Shared Claude Code project settings (hooks, etc.); settings.local.json
# stays ignored for user-specific allow-list customizations.
!.claude/settings.json
# /ingest extraction eval artifacts: the output JSON schema and the versioned
# golden fixtures are intentionally checked in (see cli/eval/README.md).
!cli/eval/batch-schema.json
!cli/eval/fixtures/**/*.json

# Radio provider canned test fixtures (PSY-1022): snapshots of real provider
# responses; adapter tests parse these instead of hitting live APIs.
!backend/internal/services/catalog/testdata/*.json

# PH-branded MapLibre basemap style (PSY-1543): source, not a credential —
# phBasemap.ts imports it at build time, so it MUST be tracked or the build
# breaks for everyone but the author.
!frontend/features/scenes/basemap/*.json

